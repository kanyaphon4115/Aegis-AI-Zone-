# Backend only — copy to .env for local development. Never commit .env.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
ANTHROPIC_API_KEY=
JWT_SECRET=
ADMIN_PHONE=
ADMIN_PASSWORD=
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000
# Optional: extra allowed frontend origins, comma-separated
# CORS_ORIGINS=
# Optional: set None only for frontend/backend custom domains on different sites
# COOKIE_SAME_SITE=Lax
# Optional: INVITE_CODES=CODE1,CODE2
# Optional: SMS_PROVIDER=console
# Optional for ThaiBulkSMS: THAIBULKSMS_KEY= / THAIBULKSMS_SECRET= / SMS_SENDER=
# Optional for Twilio: TWILIO_SID= / TWILIO_TOKEN= / TWILIO_FROM=
