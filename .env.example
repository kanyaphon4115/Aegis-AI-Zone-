# คัดลอกไปตั้งใน Vercel > Project > Settings > Environment Variables (ห้าม commit ไฟล์ .env จริง)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...        # Supabase > Project Settings > API > service_role (secret)
ANTHROPIC_API_KEY=sk-ant-...       # console.anthropic.com
JWT_SECRET=                         # สุ่มยาว 40+ ตัว จาก https://generate-secret.vercel.app/40
ADMIN_PHONE=0820431635
ADMIN_PASSWORD=254777              # รหัสเข้าหลังบ้าน (F7 บนคอม / แตะโลโก้ 5 ครั้งบนมือถือ)
INVITE_CODES=AEGIS2026,ORBITVIP
ANTHROPIC_MODEL=claude-sonnet-5

# ── ส่ง SMS OTP ─────────────────────────────────────────
# console   = ไม่ส่งจริง โชว์รหัสบนหน้าจอ ใช้ทดสอบฟรี
# thaibulksms = ใช้จริงในไทย (แนะนำ)  |  twilio = ต่างประเทศ
SMS_PROVIDER=console
SMS_SENDER=SMS
# ThaiBulkSMS — Setting > API Key ที่ thaibulksms.com
THAIBULKSMS_KEY=
THAIBULKSMS_SECRET=
# Twilio — ใช้แทน ThaiBulkSMS ได้ (ไม่ต้องกรอกถ้าใช้เจ้าบน)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
